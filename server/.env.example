# Server environment variables — copy to server/.env for local development.
# NEVER commit a real .env file or expose DATABASE_URL through Vite.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Generate a unique random secret of at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-secret
# Used only for the one-time admin creation command. Remove after bootstrapping.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
NODE_ENV=development
PORT=4000
# Exact frontend origin(s); comma-separate if there are multiple.
CLIENT_ORIGIN=http://localhost:3000
# Keep lax for same-site hosting; use none only for cross-site HTTPS frontend/API.
COOKIE_SAME_SITE=lax
