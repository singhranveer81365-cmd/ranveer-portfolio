# Server environment variables — copy to a local .env file
# Never commit real secrets and never expose DATABASE_URL through Vite.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Generate a long random secret for session signing (at least 32 bytes).
SESSION_SECRET=replace-with-a-long-random-secret
# First admin account email. Bootstrap process will use this only to create
# the initial admin account alongside a password provided securely at runtime.
ADMIN_EMAIL=you@example.com
# Optional, only if API is hosted separately from the website:
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
